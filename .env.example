# Coach mode: POST /api/chat (Next.js route) uses these keys.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
OPEN_AI_API_KEY=sk-proj-your-api-key-here

# FastAPI Stage 2 RAG origin (inlined at build time). Local default: http://localhost:8000
# Production: set to your deployed API URL. Ensure FastAPI CORSMiddleware allow_origins includes this Next.js site.
NEXT_PUBLIC_API_URL=http://localhost:8000

# FastAPI Stage 3 Research Agent origin (uvicorn port you choose, e.g. 8010).
# Falls back to NEXT_PUBLIC_API_URL when unset.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8010

# Marketing site (OG canonical + JSON-LD). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Portfolio contact CTA mailto
NEXT_PUBLIC_CONTACT_EMAIL=usamaakram17@gmail.com

# Optional: Mux playback ID for featured reel on the landing page
# NEXT_PUBLIC_MUX_PLAYBACK_ID=your_playback_id

