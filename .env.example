# Copy to .env.local for local development. Never commit real keys.

# --- Coach demo (/coach -> POST /api/chat, server-side only) ---
# At least one key enables the coach; with neither, /coach shows its offline state.
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
OPEN_AI_API_KEY=sk-proj-your-api-key-here
# Optional: coach messages allowed per client per minute (default 10).
# CHAT_RATE_LIMIT=10

# --- Demo backends (called from the browser; inlined at build time) ---
# RAG API (github.com/uusammmaa/rag-api-pgvector-pinecone). Powers /rag and /rag-supabase.
# Unset in a production build = those demos show their offline state.
# In `npm run dev`, unset falls back to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Research agent API (github.com/uusammmaa/ai-research-agent). Powers /agent.
# Falls back to NEXT_PUBLIC_API_URL when unset.
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8010

# --- Site ---
# Canonical URL for metadata, sitemap and Open Graph. Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact CTA mailto address
NEXT_PUBLIC_CONTACT_EMAIL=usamaakram17@gmail.com
# Optional: Mux playback ID for a featured reel on the landing page
# NEXT_PUBLIC_MUX_PLAYBACK_ID=your_playback_id
